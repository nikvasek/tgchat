# Telethon (личный аккаунт) — https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION=tgchat_session
# Для Railway/облака — строка сессии (python scripts/export_session.py)
TELEGRAM_SESSION_STRING=

# Telegram-бот — @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...
BOT_ADMIN_IDS=123456789

# Google Sheets
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id
# Для Railway — весь JSON credentials одной строкой
GOOGLE_CREDENTIALS_JSON=

EXCEL_OUTPUT_FILE=results.xlsx
SHEET_MONITOR=Мониторинг чатов
SHEET_GLOBAL=Глобальный поиск

# PostgreSQL — буфер для ТРУБЫ (Railway: добавьте PostgreSQL plugin)
DATABASE_URL=postgresql://user:password@localhost:5432/tgchat
